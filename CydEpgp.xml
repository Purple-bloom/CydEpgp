<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <!-- Template for rows in the bid frame -->
    <Frame name="RowTemplate" virtual="true">
        <Size>
            <AbsDimension x="230" y="25"/>
        </Size>
        <Layers>
            <Layer level="ARTWORK">
                <FontString name="$parentName" inherits="GameFontNormal">
                    <Anchors>
                        <Anchor point="LEFT">
                            <Offset><AbsDimension x="5" y="0"/></Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
                <FontString name="$parentBid" inherits="GameFontNormal">
                    <Anchors>
                        <Anchor point="LEFT">
                            <Offset><AbsDimension x="60" y="0"/></Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
                <FontString name="$parentPrio" inherits="GameFontNormal">
                    <Anchors>
                        <Anchor point="LEFT">
                            <Offset><AbsDimension x="120" y="0"/></Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button name="$parentAwardButton" inherits="UIPanelButtonTemplate" text="WIN">
                <Size><AbsDimension x="60" y="20"/></Size>
                <Anchors>
                    <Anchor point="RIGHT">
                        <Offset x="-5" y="0"/>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        local parent = this:GetParent();

                        if (parent.playerName) then
                        CydEpgp_Award(parent.playerName);
                        else
                        DEFAULT_CHAT_FRAME:AddMessage("Error: No player name found on this row!");
                        end
                    </OnClick>
                </Scripts>
            </Button>
        </Frames>
    </Frame>

    <!-- Main Frame for receiving whispers -->
    <Frame name="CydEpgpFrame" hidden="true" movable="true" enableMouse="true" frameStrata="DIALOG">
        <Size>
            <AbsDimension x="250" y="300"/>
        </Size>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>

        <Layers>
            <Layer level="OVERLAY">
                <FontString name="CydEpgpTitle" inherits="GameFontNormalSmall" text="No Item Selected">
                    <Anchors>
                        <Anchor point="TOP">
                            <Offset x="0" y="-10"/>
                        </Anchor>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>

        <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background"
                  edgeFile="Interface\DialogFrame\UI-DialogBox-Border"
                  tile="true">
            <EdgeSize>
                <AbsValue val="16"/>
            </EdgeSize>
            <TileSize>
                <AbsValue val="32"/>
            </TileSize>
            <BackgroundInsets>
                <AbsInset left="5" right="5" top="5" bottom="5"/>
            </BackgroundInsets>
        </Backdrop>

        <Frames>
            <Button inherits="UIPanelButtonTemplate" name="CydEpgpCloseButton" parent="CydEpgpFrame" text="CLEAR LIST">
                <Size><AbsDimension x="80" y="22"/></Size>
                <Anchors>
                    <Anchor point="BOTTOMRIGHT">
                        <Offset x="-4" y="5"/>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        CydEpgp_ClearEntries();
                    </OnClick>
                </Scripts>
            </Button>
        </Frames>

        <Scripts>
            <OnLoad>
                CydEpgp_OnLoad();
                this:RegisterForDrag("LeftButton");
            </OnLoad>
            <OnEvent>
                CydEpgp_OnEvent();
            </OnEvent>
            <OnDragStart>
                this:StartMoving();
            </OnDragStart>
            <OnDragStop>
                this:StopMovingOrSizing();
            </OnDragStop>
        </Scripts>
    </Frame>

    <!-- /prio table -->
    <Frame name="PrioFrame" hidden="true" movable="true" enableMouse="true" frameStrata="DIALOG">
        <Size>
            <AbsDimension x="200" y="300"/>
        </Size>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>
        <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background"
                  edgeFile="Interface\DialogFrame\UI-DialogBox-Border"
                  tile="true">
            <EdgeSize>
                <AbsValue val="16"/>
            </EdgeSize>
            <TileSize>
                <AbsValue val="32"/>
            </TileSize>
            <BackgroundInsets>
                <AbsInset left="5" right="5" top="5" bottom="5"/>
            </BackgroundInsets>
        </Backdrop>

        <Frames>
            <Button inherits="UIPanelButtonTemplate" name="PrioCloseButton" parent="PrioFrame" text="CLOSE">
                <Size><AbsDimension x="80" y="22"/></Size>
                <Anchors>
                    <Anchor point="BOTTOMRIGHT">
                        <Offset x="-4" y="5"/>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        Prio_Hide();
                    </OnClick>
                </Scripts>
            </Button>
        </Frames>

        <Layers>
            <Layer level="ARTWORK">
                <FontString name="PrioText" inherits="GameFontNormal" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="TOPLEFT">
                            <Offset><AbsDimension x="10" y="-10"/></Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad>
                this:RegisterForDrag("LeftButton");
            </OnLoad>
            <OnDragStart>
                this:StartMoving();
            </OnDragStart>
            <OnDragStop>
                this:StopMovingOrSizing();
            </OnDragStop>
        </Scripts>
    </Frame>

    <Frame name="EpgpLootTrigger" parent="UIParent">
        <Scripts>
            <OnLoad>
                this:RegisterEvent("LOOT_OPENED");
            </OnLoad>
            <OnEvent>
                CydEpgp_OnLootOpen();
            </OnEvent>
        </Scripts>
    </Frame>

    <Frame name="EpgpLootInteractFrame" hidden="true" movable="true" enableMouse="true" frameStrata="DIALOG">
        <Size>
            <AbsDimension x="250" y="300"/>
        </Size>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>
        <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background"
                  edgeFile="Interface\DialogFrame\UI-DialogBox-Border"
                  tile="true">
            <EdgeSize>
                <AbsValue val="16"/>
            </EdgeSize>
            <TileSize>
                <AbsValue val="32"/>
            </TileSize>
            <BackgroundInsets>
                <AbsInset left="5" right="5" top="5" bottom="5"/>
            </BackgroundInsets>
        </Backdrop>

        <Layers>
            <Layer level="OVERLAY">
                <FontString name="EpgpLootTitle" inherits="GameFontNormalSmall" text="LOOT">
                    <Anchors>
                        <Anchor point="TOP">
                            <Offset x="0" y="-10"/>
                        </Anchor>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>

        <Frames>
            <Button inherits="UIPanelButtonTemplate" name="ItemFrameCloseButton" parent="EpgpLootInteractFrame" text="SAVE CHANGES">
                <Size><AbsDimension x="110" y="22"/></Size>
                <Anchors>
                    <Anchor point="BOTTOMRIGHT">
                        <Offset x="-4" y="5"/>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        CydEpgp_CloseItemFrame();
                    </OnClick>
                </Scripts>
            </Button>
        </Frames>

        <Scripts>
            <OnLoad>
                this:RegisterForDrag("LeftButton");
            </OnLoad>
            <OnDragStart>
                this:StartMoving();
            </OnDragStart>
            <OnDragStop>
                this:StopMovingOrSizing();
            </OnDragStop>
        </Scripts>
    </Frame>

    <Button name="EpgpLootItemTemplate" virtual="true">
        <Size><AbsDimension x="230" y="30"/></Size>
        <Layers>
            <Layer level="ARTWORK">
                <Texture name="$parentIcon">
                    <Size><AbsDimension x="24" y="24"/></Size>
                    <Anchors><Anchor point="LEFT"><Offset x="5" y="0"/></Anchor></Anchors>
                </Texture>
                <FontString name="$parentText" inherits="GameFontNormalSmall" justifyH="LEFT">
                    <Size><AbsDimension x="130" y="24"/></Size>
                    <Anchors><Anchor point="LEFT"><Offset x="34" y="0"/></Anchor></Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button name="$parentBidButton" inherits="UIPanelButtonTemplate" text="BID">
                <Size><AbsDimension x="50" y="20"/></Size>
                <Anchors><Anchor point="RIGHT"><Offset x="-5" y="0"/></Anchor></Anchors>
                <Scripts>
                    <OnClick>
                        local parent = this:GetParent();
                        CydEpgp_StartBidding(parent.itemSlot, parent.itemLink, parent.itemName);
                    </OnClick>
                </Scripts>
            </Button>
        </Frames>
    </Button>

    <Frame name="CydEpgpConfigFrame" parent="UIParent" hidden="true" movable="true" enableMouse="true">
        <Size x="420" y="290"/>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>

        <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background"
                  edgeFile="Interface\DialogFrame\UI-DialogBox-Border"
                  tile="true">
            <BackgroundInsets left="11" right="12" top="12" bottom="11"/>
            <TileSize val="32"/>
            <EdgeSize val="32"/>
        </Backdrop>

        <Scripts>
            <OnLoad>
                this:RegisterForDrag("LeftButton")
            </OnLoad>
            <OnDragStart>this:StartMoving()</OnDragStart>
            <OnDragStop>this:StopMovingOrSizing()</OnDragStop>
        </Scripts>

        <Layers>
            <Layer level="ARTWORK">
                <FontString name="$parentTitle" inherits="GameFontNormal" text="CydEpgp Controlpanel">
                    <Anchors>
                        <Anchor point="TOP" x="0" y="-16"/>
                    </Anchors>
                </FontString>
                <FontString name="$parentRarityLabel" inherits="GameFontHighlightSmall" text="Minimum Item Rarity:">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="20" y="-48"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>

        <Frames>
            <Button name="$parentCloseButton" inherits="UIPanelCloseButton">
                <Anchors>
                    <Anchor point="TOPRIGHT" x="-5" y="-5"/>
                </Anchors>
            </Button>

            <Frame name="CydEpgpRarityDropdown" inherits="UIDropDownMenuTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" x="5" y="-64"/>
                </Anchors>
            </Frame>

            <CheckButton name="CydEpgpAutolootCheck" inherits="UICheckButtonTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" x="20" y="-105"/>
                </Anchors>
                <Scripts>
                    <OnLoad>
                        getglobal(this:GetName().."Text"):SetText("Enable Autoloot for BoEs")
                    </OnLoad>
                </Scripts>
            </CheckButton>

            <CheckButton name="CydEpgpReloadOnSaveCheck" inherits="UICheckButtonTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" x="20" y="-135"/>
                </Anchors>
                <Scripts>
                    <OnLoad>
                        getglobal(this:GetName().."Text"):SetText("Automatic UI Reloads to prevent data loss if game crashes")
                    </OnLoad>
                </Scripts>
            </CheckButton>

            <Button name="$parentImportButton" inherits="UIPanelButtonTemplate" text="Import">
                <Size x="70" y="22"/>
                <Anchors>
                    <Anchor point="BOTTOMLEFT" x="15" y="16"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        SlashCmdList.PRIOIMPORT()
                    </OnClick>
                </Scripts>
            </Button>

            <Button name="$parentActionExportButton" inherits="UIPanelButtonTemplate" text="Export Actions">
                <Size x="100" y="22"/>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentImportButton" relativePoint="RIGHT" x="4" y="0"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        slashShowActionExport()
                    </OnClick>
                </Scripts>
            </Button>

            <Button name="$parentLastActionExportButton" inherits="UIPanelButtonTemplate" text="Show last Actionexport (Backup)">
                <Size x="210" y="22"/>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentImportButton" relativePoint="LEFT" x="-2" y="25"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        slashShowLastActionExport()
                    </OnClick>
                </Scripts>
            </Button>

            <Button name="$parentSaveButton" inherits="OptionsButtonTemplate" text="Save">
                <Anchors>
                    <Anchor point="BOTTOMRIGHT" x="-15" y="16"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        CydEpgp_SaveConfig()
                    </OnClick>
                </Scripts>
            </Button>

            <Button name="$parentPresenceCheckButton" inherits="UIPanelButtonTemplate" text="Presence check">
                <Size x="110" y="22"/>
                <Anchors>
                    <Anchor point="BOTTOM" relativeTo="$parentSaveButton" relativePoint="TOP" x="-2" y="30"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        CydEpgp_PresenceCheck()
                    </OnClick>
                </Scripts>
            </Button>

            <Button name="$parentEpAwardButton" inherits="UIPanelButtonTemplate" text="Award EP">
                <Size x="110" y="22"/>
                <Anchors>
                    <Anchor point="BOTTOM" relativeTo="$parentSaveButton" relativePoint="TOP" x="-2" y="4"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        CydEpgp_OpenEpAwardFrame()
                    </OnClick>
                </Scripts>
            </Button>
        </Frames>
    </Frame>

    <!-- Import Frame -->
    <Frame name="CydEpgpImportFrame" parent="UIParent" hidden="true" movable="true" enableMouse="true" frameStrata="DIALOG">
        <Size x="450" y="320"/>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>
        <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background"
                  edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
            <BackgroundInsets left="11" right="12" top="12" bottom="11"/>
            <TileSize val="32"/>
            <EdgeSize val="32"/>
        </Backdrop>

        <Layers>
            <Layer level="ARTWORK">
                <FontString name="$parentTitle" inherits="GameFontNormal" text="Paste EPGP Import String Below:">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="20" y="-15"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>

        <Frames>
            <Button name="$parentCloseButton" inherits="UIPanelCloseButton">
                <Anchors>
                    <Anchor point="TOPRIGHT" x="-5" y="-5"/>
                </Anchors>
            </Button>

            <Frame name="$parentTextBackground">
                <Size x="390" y="210"/>
                <Anchors>
                    <Anchor point="TOPLEFT" x="20" y="-35"/>
                </Anchors>
                <Backdrop bgFile="Interface\ChatFrame\ChatFrameBackground"
                          edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
                    <BackgroundInsets left="4" right="4" top="4" bottom="4"/>
                    <TileSize val="16"/>
                    <EdgeSize val="16"/>
                </Backdrop>
                <Scripts>
                    <OnLoad>
                        this:SetBackdropColor(0, 0, 0, 0.6);
                        this:SetBackdropBorderColor(0.5, 0.5, 0.5, 0.8);
                    </OnLoad>
                </Scripts>
            </Frame>

            <ScrollFrame name="CydEpgpImportScrollFrame" inherits="UIPanelScrollFrameTemplate">
                <Size x="365" y="195"/>
                <Anchors>
                    <Anchor point="TOPLEFT" x="25" y="-42"/>
                </Anchors>
                <ScrollChild>
                    <EditBox name="CydEpgpImportEditBox" multiLine="true" autoFocus="false" enableMouse="true">
                        <Size x="360" y="195"/>
                        <FontString inherits="ChatFontNormal"/>
                        <Scripts>
                            <OnEscapePressed>
                                this:ClearFocus();
                                CydEpgpImportFrame:Hide();
                            </OnEscapePressed>
                            <OnTextChanged>
                                ScrollingEdit_OnTextChanged(this, CydEpgpImportScrollFrame);
                            </OnTextChanged>
                            <OnCursorChanged>
                                ScrollingEdit_OnCursorChanged(this, arg1, arg2, arg3, arg4);
                            </OnCursorChanged>
                            <OnUpdate>
                                ScrollingEdit_OnUpdate(this, CydEpgpImportScrollFrame);
                            </OnUpdate>
                        </Scripts>
                    </EditBox>
                </ScrollChild>
            </ScrollFrame>

            <Button name="$parentAcceptButton" inherits="UIPanelButtonTemplate" text="Import Data">
                <Size x="120" y="22"/>
                <Anchors>
                    <Anchor point="BOTTOMRIGHT" x="-20" y="15"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        CydEpgp_ExecuteImport();
                    </OnClick>
                </Scripts>
            </Button>
        </Frames>

        <Scripts>
            <OnLoad>
                this:RegisterForDrag("LeftButton");
            </OnLoad>
            <OnDragStart>this:StartMoving();</OnDragStart>
            <OnDragStop>this:StopMovingOrSizing();</OnDragStop>
        </Scripts>
    </Frame>


    <Frame name="CydEpgpEpAwardFrame" parent="UIParent" hidden="true" movable="true" enableMouse="true" frameStrata="DIALOG">
        <Size x="340" y="125"/>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>

        <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background"
                  edgeFile="Interface\DialogFrame\UI-DialogBox-Border"
                  tile="true">
            <BackgroundInsets left="11" right="12" top="12" bottom="11"/>
            <TileSize val="32"/>
            <EdgeSize val="32"/>
        </Backdrop>

        <Scripts>
            <OnLoad>
                this:RegisterForDrag("LeftButton")
            </OnLoad>
            <OnDragStart>this:StartMoving()</OnDragStart>
            <OnDragStop>this:StopMovingOrSizing()</OnDragStop>
        </Scripts>

        <Layers>
            <Layer level="ARTWORK">
                <FontString name="$parentTitle" inherits="GameFontNormal" text="Award Raid EP">
                    <Anchors>
                        <Anchor point="TOP" x="0" y="-14"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>

        <Frames>
            <Button name="$parentCloseCornerButton" inherits="UIPanelCloseButton">
                <Anchors>
                    <Anchor point="TOPRIGHT" x="-5" y="-5"/>
                </Anchors>
            </Button>

            <!-- Row 1: Wide Raid Reward Dropdown -->
            <Frame name="CydEpgpRaidRewardDropdown" inherits="UIDropDownMenuTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" x="25" y="-40"/>
                </Anchors>
                <Scripts>
                    <OnLoad>
                        UIDropDownMenu_SetWidth(this, 240)
                        UIDropDownMenu_SetButtonWidth(this, 24)
                        UIDropDownMenu_JustifyText(this, "LEFT")
                    </OnLoad>
                </Scripts>
            </Frame>

            <!-- Row 2: Action Buttons -->
            <Button name="$parentAwardButton" inherits="UIPanelButtonTemplate" text="Award">
                <Size x="90" y="22"/>
                <Anchors>
                    <Anchor point="BOTTOMLEFT" x="65" y="18"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        CydEpgp_AwardRaidReward()
                    </OnClick>
                </Scripts>
            </Button>

            <Button name="$parentCloseButton" inherits="UIPanelButtonTemplate" text="Close">
                <Size x="90" y="22"/>
                <Anchors>
                    <Anchor point="BOTTOMRIGHT" x="-65" y="18"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        CydEpgpEpAwardFrame:Hide()
                    </OnClick>
                </Scripts>
            </Button>
        </Frames>
    </Frame>

    <Frame name="CydEpgpExportFrame" parent="UIParent" hidden="true" movable="true" enableMouse="true" frameStrata="DIALOG">
        <Size x="600" y="320"/>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>
        <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background"
                  edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
            <BackgroundInsets left="11" right="12" top="12" bottom="11"/>
            <TileSize val="32"/>
            <EdgeSize val="32"/>
        </Backdrop>

        <Layers>
            <Layer level="ARTWORK">
                <FontString name="$parentTitle" inherits="GameFontNormal" text="Please copy the following String and import it to the webserver using the website:">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="20" y="-15"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>

        <Frames>
            <Button name="$parentCloseButton" inherits="UIPanelCloseButton">
                <Anchors>
                    <Anchor point="TOPRIGHT" x="-5" y="-5"/>
                </Anchors>
            </Button>

            <Frame name="$parentTextBackground">
                <Size x="390" y="210"/>
                <Anchors>
                    <Anchor point="TOPLEFT" x="20" y="-35"/>
                </Anchors>
                <Backdrop bgFile="Interface\ChatFrame\ChatFrameBackground"
                          edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
                    <BackgroundInsets left="4" right="4" top="4" bottom="4"/>
                    <TileSize val="16"/>
                    <EdgeSize val="16"/>
                </Backdrop>
                <Scripts>
                    <OnLoad>
                        this:SetBackdropColor(0, 0, 0, 0.6);
                        this:SetBackdropBorderColor(0.5, 0.5, 0.5, 0.8);
                    </OnLoad>
                </Scripts>
            </Frame>

            <ScrollFrame name="CydEpgpExportScrollFrame" inherits="UIPanelScrollFrameTemplate">
                <Size x="365" y="195"/>
                <Anchors>
                    <Anchor point="TOPLEFT" x="25" y="-42"/>
                </Anchors>
                <ScrollChild>
                    <EditBox name="CydEpgpExportEditBox" multiLine="true" autoFocus="false" enableMouse="true">
                        <Size x="360" y="195"/>
                        <FontString inherits="ChatFontNormal"/>
                        <Scripts>
                            <OnEscapePressed>
                                this:ClearFocus();
                                CydEpgpExportFrame:Hide();
                            </OnEscapePressed>
                            <OnTextChanged>
                                ScrollingEdit_OnTextChanged(this, CydEpgpExportScrollFrame);
                            </OnTextChanged>
                            <OnCursorChanged>
                                ScrollingEdit_OnCursorChanged(this, arg1, arg2, arg3, arg4);
                            </OnCursorChanged>
                            <OnUpdate>
                                ScrollingEdit_OnUpdate(this, CydEpgpExportScrollFrame);
                            </OnUpdate>
                        </Scripts>
                    </EditBox>
                </ScrollChild>
            </ScrollFrame>
        </Frames>

        <Scripts>
            <OnLoad>
                this:RegisterForDrag("LeftButton");
            </OnLoad>
            <OnHide>
                CydEpgp_OnExportFrameHide();
            </OnHide>
            <OnDragStart>this:StartMoving();</OnDragStart>
            <OnDragStop>this:StopMovingOrSizing();</OnDragStop>
        </Scripts>
    </Frame>
</Ui>